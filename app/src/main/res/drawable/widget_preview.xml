<?xml version="1.0" encoding="utf-8"?>
<!--
  Static preview shown in the widget picker. Mirrors the runtime layout: album-art-style
  gradient background with a bottom scrim, title/artist lines, and the transport row
  (shuffle · previous · play · next · repeat).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="300dp"
    android:height="160dp"
    android:viewportWidth="300"
    android:viewportHeight="160">

    <!-- Rounded card, faux album-art gradient. -->
    <path android:pathData="M20,0 H280 A20,20 0 0 1 300,20 V140 A20,20 0 0 1 280,160 H20 A20,20 0 0 1 0,140 V20 A20,20 0 0 1 20,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="300" android:endY="160">
                <item android:offset="0" android:color="#FF7A69B0" />
                <item android:offset="1" android:color="#FF2E2447" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom scrim for legibility. -->
    <path
        android:pathData="M0,70 H300 V140 A20,20 0 0 1 280,160 H20 A20,20 0 0 1 0,140 Z"
        android:fillColor="#66000000" />

    <!-- Title + artist lines. -->
    <path android:pathData="M20,92 h150 a6,6 0 0 1 6,6 a6,6 0 0 1 -6,6 h-150 a6,6 0 0 1 -6,-6 a6,6 0 0 1 6,-6 z"
        android:fillColor="#FFFFFFFF" />
    <path android:pathData="M20,112 h100 a5,5 0 0 1 5,5 a5,5 0 0 1 -5,5 h-100 a5,5 0 0 1 -5,-5 a5,5 0 0 1 5,-5 z"
        android:fillColor="#B3FFFFFF" />

    <!-- Shuffle (dimmed). -->
    <group android:translateX="34" android:translateY="126" android:scaleX="0.7" android:scaleY="0.7">
        <path android:fillColor="#B3FFFFFF"
            android:pathData="M10.59,9.17L5.41,4 4,5.41l5.17,5.17 1.42,-1.41zM14.5,4l2.04,2.04L4,18.59 5.41,20 17.96,7.46 20,9.5V4h-5.5zm0.33,9.41l-1.41,1.41 3.13,3.13L14.5,20H20v-5.5l-2.04,2.04 -3.13,-3.13z" />
    </group>

    <!-- Previous. -->
    <group android:translateX="96" android:translateY="123" android:scaleX="0.85" android:scaleY="0.85">
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M6,6h2v12H6V6zm3.5,6l8.5,6V6l-8.5,6z" />
    </group>

    <!-- Play (larger). -->
    <group android:translateX="138" android:translateY="118">
        <path android:fillColor="#FFFFFFFF" android:pathData="M8,5v14l11,-7z" />
    </group>

    <!-- Next. -->
    <group android:translateX="180" android:translateY="123" android:scaleX="0.85" android:scaleY="0.85">
        <path android:fillColor="#FFFFFFFF"
            android:pathData="M6,18l8.5,-6L6,6v12zM16,6v12h2V6h-2z" />
    </group>

    <!-- Repeat (dimmed). -->
    <group android:translateX="238" android:translateY="126" android:scaleX="0.7" android:scaleY="0.7">
        <path android:fillColor="#B3FFFFFF"
            android:pathData="M7,7h10v3l4,-4 -4,-4v3H5v6h2V7zm10,10H7v-3l-4,4 4,4v-3h12v-6h-2v4z" />
    </group>
</vector>
